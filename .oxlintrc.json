{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "jsx-a11y",
    "oxc",
    "react",
    "react-perf",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "rules": {
    // "correctness" overrides.
    "react/exhaustive-deps": "warn",
    "typescript/no-floating-promises": ["error", { "ignoreIIFE": true }],

    // "pedantic" overrides.
    "eslint/max-lines-per-function": [
      "error",
      { "max": 150, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/max-nested-callbacks": ["error", { "max": 2 }],
    "eslint/require-await": "off",
    "import/max-dependencies": [
      "error",
      { "max": 25, "ignoreTypeImports": true }
    ],
    "typescript/no-confusing-void-expression": [
      "error",
      { "ignoreArrowShorthand": true }
    ],
    "typescript/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false } }
    ],
    "typescript/strict-boolean-expressions": [
      "error",
      { "allowNullableBoolean": true, "allowNullableString": true }
    ],
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "allowDefaultCaseForExhaustiveSwitch": false,
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "unicorn/no-useless-undefined": "off",

    // "perf" overrides.
    "react_perf/jsx-no-new-array-as-prop": "off",
    "react_perf/jsx-no-new-function-as-prop": "off",

    // "restriction" overrides.
    "eslint/class-methods-use-this": "off",
    "eslint/default-case": "off",
    "eslint/no-empty-function": ["error", { "allow": ["privateConstructors"] }],
    "eslint/no-undefined": "off",
    "eslint/no-unused-expressions": "off",
    "import/unambiguous": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "react/jsx-filename-extension": [
      "error",
      { "allow": "as-needed", "extensions": ["jsx", "tsx"] }
    ],
    "react/only-export-components": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",

    // "style" overrides.
    "eslint/capitalized-comments": "off",
    "eslint/func-style": [
      "error",
      "declaration",
      { "allowArrowFunctions": true }
    ],
    "eslint/id-length": "off",
    "eslint/init-declarations": "off",
    "eslint/no-labels": ["error", { "allowLoop": true }],
    "eslint/no-magic-numbers": "off",
    "eslint/no-nested-ternary": "warn",
    "eslint/no-ternary": "off",
    "eslint/prefer-destructuring": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "off",
    "import/consistent-type-specifier-style": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "react/jsx-curly-brace-presence": [
      "error",
      { "propElementValues": "always" }
    ],
    "react/jsx-props-no-spreading": "off",
    "react/no-set-state": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "unicorn/no-nested-ternary": "off", // Similar to `eslint/no-nested-ternary`.
    "unicorn/switch-case-braces": ["error", "avoid"],

    // "suspicious" overrides.
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["astro.config.mjs", "eslint.config.js"],
      "rules": {
        "import/no-default-export": "off",
        "import/no-named-as-default-member": "off"
      }
    }
  ],
  "ignorePatterns": [],
  "globals": {},
  "env": {
    "builtin": true
  },
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "react": {
      "formComponents": [],
      "linkComponents": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    }
  }
}
